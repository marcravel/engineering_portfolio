<file path="src/styles/global.css">
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;700;800&display=swap');

:root {
  --color-bg: #0a0a0a;
  --color-bg-elevated: rgba(30, 30, 40, 0.4);
  --color-bg-card: rgba(255, 255, 255, 0.02);
  --color-border: rgba(255, 255, 255, 0.1);
  --color-text-primary: #f8fafc;
  --color-text-secondary: #94a3b8;
  --color-accent-1: #3b82f6; /* Blue */
  --color-accent-2: #8b5cf6; /* Purple */
  --font-primary: 'Inter', sans-serif;
  --font-display: 'Outfit', sans-serif;
  --container-width: 1100px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-family: var(--font-primary);
  background-color: var(--color-bg);
  color: var(--color-text-primary);
  line-height: 1.6;
}

body {
  overflow-x: hidden;
  background-image: radial-gradient(circle at top right, rgba(59, 130, 246, 0.1), transparent 40%),
                    radial-gradient(circle at bottom left, rgba(139, 92, 246, 0.1), transparent 40%);
  min-height: 100vh;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  font-weight: 700;
  line-height: 1.2;
}

h1 { font-size: 2.5rem; }
h2 { font-size: 2rem; }
h3 { font-size: 1.75rem; }
h4 { font-size: 1.5rem; }
h5 { font-size: 1.25rem; }
h6 { font-size: 1rem; }

a {
  color: inherit;
  text-decoration: none;
  transition: color 0.3s ease;
}

a:hover {
  color: var(--color-accent-1);
}

.container {
  max-width: var(--container-width);
  margin: 0 auto;
  padding: 0 2rem;
}

.section {
  padding: 60px 0;
}

.section-title {
  font-size: 3rem;
  margin-bottom: 3rem;
  text-align: center;
}

.section-title span {
  background: linear-gradient(to right, var(--color-accent-1), var(--color-accent-2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Utilities */
.glass {
  background: var(--color-bg-elevated);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--color-border);
  border-radius: 16px;
}

.gradient-text {
  background: linear-gradient(135deg, var(--color-accent-1), var(--color-accent-2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.75rem;
  font-family: var(--font-display);
  font-weight: 600;
  border-radius: 99px;
  cursor: pointer;
  transition: all 0.3s ease;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-accent-1), var(--color-accent-2));
  color: white;
  box-shadow: 0 10px 20px rgba(59, 130, 246, 0.2);
}

.btn-primary:hover {
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 15px 25px rgba(59, 130, 246, 0.4);
}

.btn-outline {
  background: transparent;
  color: var(--color-text-primary);
  border: 1px solid var(--color-border);
  backdrop-filter: blur(4px);
}

.btn-outline:hover {
  color: var(--color-text-primary);
  border-color: var(--color-accent-2);
  background: rgba(139, 92, 246, 0.05);
}

/* Animations */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-up {
  animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* --- Layout & Utility additions replacing Bootstrap --- */
/* Typography */
.text-center { text-align: center; }
.text-muted { color: var(--color-text-secondary); }
.fw-bold { font-weight: 700; }
.fw-light { font-weight: 300; }
.text-uppercase { text-transform: uppercase; }
.small { font-size: 0.875rem; }
.lead { font-size: 1.25rem; opacity: 0.9; }

.fs-1 { font-size: 2.5rem; }
.fs-2 { font-size: 2rem; }
.fs-3 { font-size: 1.75rem; }
.fs-4 { font-size: 1.5rem; }
.fs-5 { font-size: 1.25rem; }
.fs-6 { font-size: 1rem; }
.w-100 { width: 100%; }
.h-100 { height: 100%; }
.img-fluid { max-width: 100%; height: auto; }
.rounded-full { border-radius: 9999px; }

/* Display & Flex */
.d-flex { display: flex; }
.d-none { display: none; }
.flex-column { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.align-items-center { align-items: center; }
.align-items-stretch { align-items: stretch; }
.justify-content-center { justify-content: center; }
.justify-content-between { justify-content: space-between; }
.gap-2 { gap: 0.5rem; }
.gap-3 { gap: 1rem; }
.gap-4 { gap: 1.5rem; }

/* Margins & Paddings */
.m-0 { margin: 0; }
.mb-0 { margin-bottom: 0; }
.mb-1 { margin-bottom: 0.25rem; }
.mb-2 { margin-bottom: 0.5rem; }
.mb-3 { margin-bottom: 1rem; }
.mb-4 { margin-bottom: 1.5rem; }
.mb-5 { margin-bottom: 3rem; }
.mt-3 { margin-top: 1rem; }
.mt-4 { margin-top: 1.5rem; }
.mt-5 { margin-top: 3rem; }
.mt-auto { margin-top: auto; }
.ms-auto { margin-left: auto; }
.me-2 { margin-right: 0.5rem; }
.me-3 { margin-right: 1rem; }
.p-0 { padding: 0; }
.p-3 { padding: 1rem; }
.p-4 { padding: 1.5rem; }
.py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.py-3 { padding-top: 1rem; padding-bottom: 1rem; }
.py-4 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.py-5 { padding-top: 3rem; padding-bottom: 3rem; }
.px-3 { padding-left: 1rem; padding-right: 1rem; }
.px-4 { padding-left: 1.5rem; padding-right: 1.5rem; }

/* Grid Systems */
.grid { display: grid; gap: 1.5rem; }
.grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
.grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

/* Responsive Media Queries */
@media (max-width: 768px) {
    .md-flex-column { flex-direction: column; }
    .md-text-center { text-align: center; }
    .md-mt-4 { margin-top: 1.5rem; }
    .section { padding: 60px 0; }
    .section-title { font-size: 2rem; }
}

@media (min-width: 768px) {
    .md-grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .d-md-flex { display: flex; }
    .d-md-none { display: none; }
}

@media (min-width: 1024px) {
    .lg-grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lg-grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lg-grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .lg-d-flex { display: flex; }
    .lg-d-none { display: none; }
}

/* Base Component Additions */
.badge {
  display: inline-block;
  padding: 0.35em 0.65em;
  font-size: 0.75em;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  vertical-align: baseline;
  border-radius: 0.375rem;
  background-color: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
  color: var(--color-text-primary);
}

@keyframes pulseIndicator {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(59, 130, 246, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
}
</file>

<file path="src/components/pages/ProjectDetail.astro">
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import fs from "fs/promises";
import path from "path";
import { useTranslatedPath } from "../../i18n/ui";

export interface Props {
    lang: "en" | "fr" | "tr";
    project: any;
}
const { lang, project } = Astro.props;
const translatePath = useTranslatedPath(lang);

// Helper to determine the hero image URL with BASE_URL routing
let heroImage = project.image;
if (heroImage && !heroImage.startsWith("http")) {
    const baseUrl = import.meta.env.BASE_URL.endsWith("/")
        ? import.meta.env.BASE_URL
        : import.meta.env.BASE_URL + "/";
    heroImage = `${baseUrl}${heroImage}`;
}

let descriptionContent = project.longDescription
    ? typeof project.longDescription === "object"
        ? project.longDescription[lang]
        : project.longDescription
    : project.description[lang] || project.description.en;
let isTextFile =
    typeof descriptionContent === "string" &&
    descriptionContent.endsWith(".txt");
if (isTextFile) {
    try {
        const filePath = path.join(
            process.cwd(),
            "public",
            descriptionContent.replace(/^\/+/, ""),
        );
        descriptionContent = await fs.readFile(filePath, "utf-8");
    } catch (err) {
        console.error("Failed to read description file:", err);
        descriptionContent =
            project.description[lang] || project.description.en;
    }
}

const subtitleRegex = /^(Project Overview|Role & Responsibilities|System Architecture|Results & Recognition|Aperçu du Projet|Rôle et Responsabilités|Architecture du Système|Résultats et Reconnaissance|Proje Özeti|Rol ve Sorumluluklar|Sistem Mimarisi|Sonuçlar ve Başarılar):?$/i;

const parsedLongDescription = (
    typeof descriptionContent === "string" ? descriptionContent : ""
)
    .split("\n")
    .filter((p) => p.trim() !== "")
    .map((p) => {
        const trimmed = p.trim();
        if (subtitleRegex.test(trimmed)) {
            return `<h3 class="mb-3 mt-5" style="color: var(--color-accent-1); font-size: 1.5rem;">${trimmed}</h3>`;
        }
        return `<p class="mb-3 text-muted">${trimmed}</p>`;
    })
    .join("");

const t_back = {
    en: "Back to Projects",
    fr: "Retour aux projets",
    tr: "Projelere Dön",
};
const t_tech = {
    en: "Technologies Built With",
    fr: "Technologies Utilisées",
    tr: "Kullanılan Teknolojiler",
};
const t_gallery = { en: "Gallery", fr: "Galerie", tr: "Galeri" };
const t_overview = { en: "Overview", fr: "Aperçu", tr: "Genel Bakış" };
---

<BaseLayout title={`${project.title[lang]} - Marc Projects`}>
    <section class="section">
        <div class="container animate-fade-up">
            <!-- Navigation Back -->
            <div class="mb-5">
                <a
                    href={translatePath("/projects")}
                    class="text-decoration-none d-inline-flex align-items-center gap-2" style="color: var(--color-accent-1);"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        fill="currentColor"
                        viewBox="0 0 16 16"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"
                        ></path>
                    </svg>
                    <span style="font-weight: 500;">{t_back[lang]}</span>
                </a>
            </div>

            <!-- Project Header -->
            <div class="mb-5 text-center">
                <div class="mb-4">
                    <span class="badge px-4 py-2" style="background: rgba(59, 130, 246, 0.2); border: 1px solid rgba(59, 130, 246, 0.5); color: #fff; font-size: 1rem; text-transform: uppercase; letter-spacing: 1px;">
                        {project.category[lang]}
                    </span>
                </div>
                <h1 class="mb-4 gradient-text" style="font-size: 3rem;">{project.title[lang]}</h1>

                {
                    project.achievements && project.achievements[lang] && (
                        <div class="d-inline-block p-3 rounded glass mb-5" style="border-left: 3px solid var(--color-accent-2);">
                            <span
                                style="color: var(--color-text-primary); font-weight: 600;"
                            >
                                {project.achievements[lang]}
                            </span>
                        </div>
                    )
                }

                <!-- Technologies & Architecture right under title -->
                <div class="mb-5 d-flex flex-column align-items-center">
                    <h4
                        class="text-uppercase mb-3 small fw-bold"
                        style="color: var(--color-text-secondary); letter-spacing: 2px;"
                    >
                        {t_tech[lang]}
                    </h4>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        {
                            project.techStack.map((tech) => (
                                <span class="badge px-3 py-2" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border); font-size: 0.9rem;">
                                    {tech}
                                </span>
                            ))
                        }
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg-grid-cols-3 gap-5">
                <!-- Left Column: Gallery -->
                <div class="order-2 lg-order-2">
                    {
                        project.gallery && project.gallery.length > 0 && (
                            <div class="glass p-4 sticky-top" style="top: 100px;">
                                <h3
                                    class="mb-4"
                                    style="color: var(--color-text-primary); font-size: 1.5rem;"
                                >
                                    {t_gallery[lang]}
                                </h3>
                                <div class="grid grid-cols-2 gap-3">
                                    {project.gallery.map((galleryImg) => {
                                        // Handle correct routing for gallery images
                                        let imgPath = galleryImg;
                                        if (!imgPath.startsWith("http")) {
                                            const bUrl =
                                                import.meta.env.BASE_URL.endsWith(
                                                    "/",
                                                )
                                                    ? import.meta.env.BASE_URL
                                                    : import.meta.env.BASE_URL +
                                                      "/";
                                            imgPath = `${bUrl}${imgPath}`;
                                        }
                                        return (
                                            <div
                                                class="glass overflow-hidden"
                                                style="cursor: pointer; aspect-ratio: 1; padding: 0;"
                                            >
                                                <img
                                                    src={imgPath}
                                                    class="h-100 w-100 gallery-image"
                                                    style="object-fit: cover; transition: transform 0.3s ease; display: block;"
                                                    alt="Project Gallery Image"
                                                    loading="lazy"
                                                />
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        )
                    }
                </div>

                <!-- Right Column: Media Hero & Description -->
                <div class="lg-grid-col-span-2 order-1 lg-order-1" style="grid-column: span 2;">
                    <!-- Media Hero (YouTube or Image) -->
                    <div
                        class="mb-5 glass overflow-hidden p-0"
                    >
                        {
                            project.youtubeId ? (
                                <div style="position: relative; width: 100%; padding-bottom: 56.25%;">
                                    <iframe
                                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
                                        src={`https://www.youtube.com/embed/${project.youtubeId}?rel=0`}
                                        title="Technical hardware overview of the project"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen
                                    />
                                </div>
                            ) : (
                                heroImage && (
                                    <img
                                        src={heroImage}
                                        alt={project.title[lang]}
                                        class="w-100"
                                        style="object-fit: cover; max-height: 500px; display: block;"
                                    />
                                )
                            )
                        }
                    </div>

                    <!-- Long Description -->
                    <div class="mb-5 glass p-4 md-p-5">
                        <h3
                            class="mb-4 gradient-text"
                            style="font-size: 2rem;"
                        >
                            {t_overview[lang]}
                        </h3>
                        <div class="project-details" style="line-height: 1.8; font-size: 1.1rem;">
                            <span set:html={parsedLongDescription} />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Custom Modal -->
    <div id="customImageModal" class="custom-modal">
        <div class="custom-modal-content">
            <span class="custom-modal-close">&times;</span>
            <img id="customModalImage" src="" alt="Large project image view" />
        </div>
    </div>
</BaseLayout>

<style>
    .order-1 { order: 1; }
    .order-2 { order: 2; }
    @media (min-width: 1024px) {
        .lg-order-1 { order: 1; }
        .lg-order-2 { order: 2; }
    }
    
    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .gallery-image:hover {
        transform: scale(1.1);
    }
    
    /* Custom Modal Styles */
    .custom-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(10, 10, 10, 0.9);
        backdrop-filter: blur(5px);
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .custom-modal.show {
        display: flex;
        opacity: 1;
    }
    
    .custom-modal-content {
        position: relative;
        max-width: 90%;
        max-height: 90%;
    }
    
    .custom-modal-content img {
        max-width: 100%;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 12px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }
    
    .custom-modal-close {
        position: absolute;
        top: -40px;
        right: 0;
        color: white;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
        transition: color 0.3s;
    }
    
    .custom-modal-close:hover {
        color: var(--color-accent-1);
    }
</style>

<script>
    const galleryImages = document.querySelectorAll(".gallery-image");
    const modal = document.getElementById("customImageModal");
    const modalImg = document.getElementById("customModalImage");
    const closeBtn = document.querySelector(".custom-modal-close");

    galleryImages.forEach((img) => {
        img.addEventListener("click", function () {
            if (modal && modalImg) {
                modalImg.src = this.src;
                modal.classList.add("show");
                document.body.style.overflow = "hidden"; // Prevent scrolling
            }
        });
    });

    const closeModal = () => {
        if (modal) {
            modal.classList.remove("show");
            document.body.style.overflow = "auto";
        }
    };

    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    
    if (modal) {
        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });
    }
</script>
</file>

